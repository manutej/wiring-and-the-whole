{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiring-and-the-whole.local/pack-blind-eval/run_config.v0.json",
  "title": "Blind pack-only eval run config",
  "type": "object",
  "additionalProperties": false,
  "required": ["harness_version", "cases"],
  "properties": {
    "harness_version": {
      "type": "string",
      "const": "pack-blind-eval-v0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pack_id", "questions_path", "grade_mode"],
        "properties": {
          "pack_id": { "type": "string" },
          "questions_path": { "type": "string" },
          "grade_mode": { "type": "string", "enum": ["io"] }
        }
      }
    }
  }
}
