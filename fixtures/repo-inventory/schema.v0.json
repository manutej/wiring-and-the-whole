{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "repo-inventory.v0",
  "type": "object",
  "required": ["schema_version", "root", "total_files", "total_bytes", "java_files"],
  "properties": {
    "schema_version": { "const": "repo-inventory.v0" },
    "root": { "type": "string" },
    "scanned_at_utc": { "type": "string" },
    "total_files": { "type": "integer", "minimum": 0 },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "java_files": { "type": "integer", "minimum": 0 },
    "java_bytes": { "type": "integer", "minimum": 0 },
    "by_extension": { "type": "object" }
  }
}
